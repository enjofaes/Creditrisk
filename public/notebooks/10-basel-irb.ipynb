      "source": "# Basel IRB Capital Requirements",
      "metadata": {},
      "id": "title"
    },
    {
      "cell_type": "code",
      "source": "import numpy as np\nfrom scipy.stats import norm\n\ndef irb_rw(pd, lgd, r=0.15):\n    k = lgd*norm.cdf((norm.ppf(pd)+r**0.5/(1-r)**0.5*norm.ppf(0.999))/(1/(1-r))**0.5) - lgd*pd\n    return k*12.5*100\n\nprint(f\"BBB corporate RW: {irb_rw(0.01, 0.45):.1f}%\")",
      "metadata": {},
